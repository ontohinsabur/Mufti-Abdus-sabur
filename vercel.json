{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/services/facebook-engagement-campaign/", "destination": "/services/facebook-ads-campaign/", "permanent": true },
    { "source": "/services/facebook-video-views-campaign/", "destination": "/services/facebook-ads-campaign/", "permanent": true },
    { "source": "/sitemap_index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/:name([a-z_]+-sitemap\\d*).xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/wp-sitemap-:rest(.*)", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/:y(\\d{4})/:m(\\d{2})/:d(\\d{2})/:slug/feed/", "destination": "/:y/:m/:d/:slug/", "permanent": true },
    { "source": "/:y(\\d{4})/", "destination": "/blog/", "permanent": true },
    { "source": "/:y(\\d{4})/:m(\\d{2})/", "destination": "/blog/", "permanent": true },
    { "source": "/:y(\\d{4})/:m(\\d{2})/:d(\\d{2})/", "destination": "/blog/", "permanent": true },
    { "source": "/page/:n(\\d+)/", "destination": "/blog/page/:n/", "permanent": true },
    { "source": "/author/:path*/", "destination": "/about/", "permanent": true },
    { "source": "/category/:slug/feed/", "destination": "/category/:slug/", "permanent": true },
    { "source": "/tag/:slug/feed/", "destination": "/tag/:slug/", "permanent": true },
    { "source": "/comments/feed/", "destination": "/blog/", "permanent": true },
    { "source": "/wp-json/:path*/", "destination": "/", "permanent": false },
    { "source": "/xmlrpc.php", "destination": "/", "permanent": false },
    {
      "source": "/crm/:path*",
      "destination": "https://muftiabdussabur-crm.vercel.app/",
      "permanent": false
    },
    {
      "source": "/customer-portal/:path*",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/my-account/:path*",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/cart/:path*",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/checkout/:path*",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/shop/:path*",
      "destination": "/services/",
      "permanent": false
    },
    {
      "source": "/refund_returns/",
      "destination": "/service-refund-policy/",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "https://crm.muftiabdussabur.com/",
      "permanent": false
    },
    {
      "source": "/feed/:path*",
      "destination": "/blog/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/mas-service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/mas-manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/wp-content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-served-by",
          "value": "Vercel"
        }
      ]
    }
  ]
}